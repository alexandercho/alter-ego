{
    "compilerOptions": {
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "ES2024"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noImplicitReturns": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "types": [
            "node"
        ]
    },
    "include": [
        "scripts/**/*.ts"
    ],
    "exclude": [
        "backend",
        "frontend",
        "node_modules"
    ]
}
