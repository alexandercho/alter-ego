{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": [
                "./*"
            ],
            "components/*": [
                "./components/*"
            ],
            "constants/*": [
                "./constants/*"
            ],
            "lib/*": [
                "./lib/*"
            ],
            "screens/*": [
                "./screens/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
